<?xml version="1.0" encoding="utf-8"?>
<!--
  Visualizers for Pepper's runtime types, for Visual Studio and WinDbg. A
  program built with `-g` on Windows carries this file in its .pdb: the
  compiler links with /NATVIS.
-->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="String">
    <DisplayString Condition="_data == 0">""</DisplayString>
    <DisplayString>{_data,[_size]s8}</DisplayString>
    <StringView>_data,[_size]s8</StringView>
    <Expand>
      <Item Name="[size]">_size</Item>
      <Item Name="[length]">_length</Item>
      <Item Name="[ref count]">__refcount</Item>
      <Item Name="[weak count]">__weakcount</Item>
    </Expand>
  </Type>
  <Type Name="Array&lt;*&gt;">
    <DisplayString>{{ count={_size} }}</DisplayString>
    <Expand>
      <Item Name="[count]">_size</Item>
      <Item Name="[capacity]">_capacity</Item>
      <Item Name="[ref count]">__refcount</Item>
      <Item Name="[weak count]">__weakcount</Item>
      <ArrayItems>
        <Size>_size</Size>
        <ValuePointer>_data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
  <!-- The ring _slots is an Array of Optionals: element i is the value of
       slot (_head + i) % capacity. -->
  <Type Name="Deque&lt;*&gt;">
    <DisplayString>{{ count={_count} }}</DisplayString>
    <Expand>
      <Item Name="[count]">_count</Item>
      <Item Name="[ref count]">__refcount</Item>
      <Item Name="[weak count]">__weakcount</Item>
      <CustomListItems Condition="_count != 0">
        <Variable Name="index" InitialValue="0" />
        <Loop>
          <Break Condition="index == _count" />
          <Item Name="[{index}]">_slots-&gt;_data[(_head + index) % _slots-&gt;_size].Value__value</Item>
          <Exec>index++</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>
  <!-- A value enum, held inline: __tag is the case's position. -->
  <Type Name="Optional&lt;*&gt;">
    <DisplayString Condition="__tag == 0">Empty</DisplayString>
    <DisplayString>Value({Value__value})</DisplayString>
    <Expand>
      <Item Name="value" Condition="__tag == 1">Value__value</Item>
    </Expand>
  </Type>
</AutoVisualizer>
