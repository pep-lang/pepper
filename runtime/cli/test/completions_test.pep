# The cli module's shell completion scripts: what each shell's script
# offers for options, commands, enum choices and file names.

import cli;
import [Path] from io;
import "typed_test";

pkg_parser(): cli.Parser {
    var parser = cli.Parser("pkg", "Manages packages");
    parser.flag("verbose", "v", "say more", global = true);
    var add = parser.command("add", "Adds a dependency");
    add.option<Speed>("speed", "s", "how fast");
    add.option<int>("jobs");
    add.positional<Path>("name", "the package's file");
    return parser;
}

[Test]
writes_a_bash_script() {
    var expected = "# Bash completion for pkg, generated by its cli.Parser.\n"
        + "_pkg_complete() {\n"
        + "    local cur=\"${COMP_WORDS[COMP_CWORD]}\" prev=\"${COMP_WORDS[COMP_CWORD-1]}\" cmd='pkg' i\n"
        + "    for ((i = 1; i < COMP_CWORD; i++)); do\n"
        + "        case \"$cmd:${COMP_WORDS[i]}\" in\n"
        + "            'pkg:add') cmd='pkg add' ;;\n"
        + "        esac\n"
        + "    done\n"
        + "    COMPREPLY=()\n"
        + "    case \"$cmd\" in\n"
        + "        'pkg')\n"
        + "            case \"$prev\" in\n"
        + "            esac\n"
        + "            if [[ \"$cur\" == -* ]]; then\n"
        + "                COMPREPLY=($(compgen -W '--verbose -v --help -h' -- \"$cur\"))\n"
        + "            else\n"
        + "                COMPREPLY=($(compgen -W 'add' -- \"$cur\"))\n"
        + "            fi\n"
        + "            ;;\n"
        + "        'pkg add')\n"
        + "            case \"$prev\" in\n"
        + "                --speed|-s) COMPREPLY=($(compgen -W 'fast debug-info' -- \"$cur\")); return ;;\n"
        + "                --jobs) return ;;\n"
        + "            esac\n"
        + "            if [[ \"$cur\" == -* ]]; then\n"
        + "                COMPREPLY=($(compgen -W '--speed -s --jobs --verbose -v --help -h' -- \"$cur\"))\n"
        + "            else\n"
        + "                COMPREPLY+=($(compgen -f -- \"$cur\"))\n"
        + "            fi\n"
        + "            ;;\n"
        + "    esac\n"
        + "}\n"
        + "complete -F _pkg_complete pkg\n";
    expect_equal(pkg_parser().completions(cli.Shell.Bash), expected);
}

[Test]
writes_zsh_fish_and_powershell_scripts() {
    var parser = pkg_parser();
    var zsh = parser.completions(cli.Shell.Zsh);
    expect_true(zsh.starts_with("#compdef pkg\n"));
    expect_true(zsh.contains("                --speed|-s) compadd -- fast debug-info; return ;;\n"));
    expect_true(zsh.contains("                _files\n"));
    expect_true(zsh.ends_with("compdef _pkg pkg\n"));

    var fish = parser.completions(cli.Shell.Fish);
    expect_true(
        fish.contains(
            "complete -c pkg -n '__pkg_command_is \\'pkg add\\'' -l speed -s s -x -a 'fast debug-info' -d 'how fast'\n"
        )
    );
    expect_true(fish.contains("complete -c pkg -n '__pkg_command_is \\'pkg\\'' -a 'add' -d 'Adds a dependency'\n"));
    expect_true(
        fish.contains(
            "complete -c pkg -n '__pkg_command_is \\'pkg add\\'; and not __pkg_command_after --speed -s --jobs' -F\n"
        )
    );

    var powershell = parser.completions(cli.Shell.Powershell);
    expect_true(powershell.contains("Register-ArgumentCompleter -Native -CommandName 'pkg' -ScriptBlock {\n"));
    expect_true(powershell.contains("                '-s' { $candidates = @('fast', 'debug-info'); break }\n"));
}

[Test]
quotes_help_text_for_each_shell() {
    var parser = cli.Parser("it's");
    parser.flag("x", help = "it's here");
    expect_true(parser.completions(cli.Shell.Fish).contains("-d 'it\\'s here'"));
    expect_true(parser.completions(cli.Shell.Bash).contains("cmd='it'\\''s'"));
    expect_true(parser.completions(cli.Shell.Powershell).contains("-CommandName 'it''s'"));
}
