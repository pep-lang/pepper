## `--bindings swift|java`: Swift or Java code over a library's C functions
## (see the book's "iOS and Android"), so an app calls `greet("x")` with
## Swift or Java values instead of C ones.
##
## Both are written beside the C header, from the program's `[Export]`s
## (`sema.Exports`). Swift's is a `.swift` file of wrappers and a
## `module.modulemap` naming the header's C module `C<name>`: a `String`
## goes in as its UTF-8 bytes and comes back as a copy (the C copy freed),
## and a struct handle is a class that releases its reference in `deinit`.
## Java's is a `.jar` of classes written here byte by byte (`_class_file`),
## so no JDK is needed: a class of `static native` methods that loads the
## library, and a class for each handle, closed with `close()`; and the C
## JNI functions (`Java_<package>_<class>_<method>`) that convert Java's
## values and call the exports, a `.c` file the link compiles into the
## shared library. Names are camel case (`count_words` is `countWords`).

import [Diagnostic, Location] from compiler.diagnostic;
import compiler.sema;
import "aar";
import "library";
import "xcframework";

## The language `--bindings` writes bindings in.
export enum BindingsKind {
    ## Swift wrappers and a module map (`<name>.swift`, `module.modulemap`).
    Swift,
    ## Java classes and their JNI functions (`<name>.jar`, `<name>_jni.c`).
    Java,
}

## The files `--bindings` writes beside the header `<name>.h`, in the
## order `binding_files` returns their contents: for Swift `<name>.swift`
## and `module.modulemap`; for Java `<name>.jar` and `<name>_jni.c`, the C
## the link compiles in.
##
## @param kind the language
## @param name the library's name, the header's stem
## @returns the file names
export binding_file_names(kind: BindingsKind, name: String): String[] {
    if (kind == BindingsKind.Swift) {
        return [$"{name}.swift", "module.modulemap"];
    }
    return [$"{name}.jar", $"{name}_jni.c"];
}

## The contents of the files `binding_file_names` names, for `exports`.
##
## @param kind the language
## @param name the library's name, the header's stem
## @param exports what the program exports
## @param representations each enum's stored type, by name
## @returns each file's bytes, or the error at the export that cannot be bound
export binding_files(
    kind: BindingsKind, name: String, exports: sema.Exports, representations: HashMap<String, (String, long)>
): Result<u8[][], Diagnostic> {
    if (kind == BindingsKind.Swift) {
        var swift = swift_bindings(name, exports, representations);
        if (swift.is_err()) {
            return Result<u8[][], Diagnostic>.Err(swift.error());
        }
        var map = $"module {swift_c_module(name)} {{\n    header \"{name}.h\"\n    export *\n}}\n";
        return Result<u8[][], Diagnostic>.Ok([swift.value().bytes(), map.bytes()]);
    }
    var java = java_bindings(name, exports, representations);
    if (java.is_err()) {
        return Result<u8[][], Diagnostic>.Err(java.error());
    }
    var (jar, glue) = java.value();
    return Result<u8[][], Diagnostic>.Ok([jar, glue.bytes()]);
}

## Returns the Swift wrappers of `exports`, which import the C module
## `swift_c_module(name)`: a `public func` for each export, named in camel
## case, and a `public final class` for each struct handle.
##
## @param name the library's name
## @param exports what the program exports
## @param representations each enum's stored type, by name
## @returns the Swift source, or the error when two exports get one name
export swift_bindings(
    name: String, exports: sema.Exports, representations: HashMap<String, (String, long)>
): Result<String, Diagnostic> {
    var named = _camel_names(exports, "Swift");
    if (named.is_err()) {
        return Result<String, Diagnostic>.Err(named.error());
    }
    var module = swift_c_module(name);
    var out = StringBuilder();
    out.append($"// {name}.swift: generated by the Pepper compiler. Do not edit.\n");
    out.append($"// Swift wrappers of the C functions in {name}.h (the module {module}).\n");
    out.append($"import {module}\n");
    for (var handle in exports.handles) {
        out.append(
            $"\n/// A reference to a Pepper `{handle.c_type}`, released when this object is.\npublic final class {handle.c_type} {{\n    let handle: OpaquePointer\n\n    init(owning handle: OpaquePointer) {{\n        self.handle = handle\n    }}\n\n    deinit {{\n        {module}.{handle.release}(handle)\n    }}\n}}\n"
        );
    }
    for (var i in 0..exports.functions.count) {
        var e = exports.functions[i];
        var parameters = Array<String>();
        var arguments = Array<String>();
        var strings = Array<String>();
        for (var (parameter, ty) in e.parameters) {
            parameters.append($"_ `{parameter}`: {_swift_type(ty, exports, representations)}");
            if (sema.is_export_string(ty)) {
                var at = strings.count;
                strings.append(parameter);
                arguments.append($"b{at}.baseAddress");
                arguments.append($"b{at}.count - 1");
            } else if (_handle_of(ty, exports).is_value()) {
                arguments.append($"`{parameter}`.handle");
            } else {
                arguments.append($"`{parameter}`");
            }
        }
        # Each string's bytes, NUL-terminated, live through the call.
        var call = $"{module}.{e.symbol}({", ".join(arguments)})";
        var s = strings.count;
        while (s > 0) {
            s -= 1;
            call = $"s{s}.withUnsafeBufferPointer {{ b{s} in {call} }}";
        }
        var body = StringBuilder();
        for (var j in 0..strings.count) {
            body.append($"    let s{j} = `{strings[j]}`.utf8CString\n");
        }
        var result = "";
        var handle = _handle_of(e.result, exports);
        if (sema.is_export_string(e.result)) {
            result = " -> String";
            body.append(
                $"    let result = {call}!\n    defer {{ {module}.{sema.STRING_FREE}(result) }}\n    return String(cString: result)\n"
            );
        } else if (handle.is_value()) {
            result = $" -> {handle.value().c_type}";
            body.append($"    return {handle.value().c_type}(owning: {call}!)\n");
        } else if (_is_void(e.result)) {
            body.append($"    {call}\n");
        } else {
            result = $" -> {_swift_type(e.result, exports, representations)}";
            body.append($"    return {call}\n");
        }
        out.append(
            $"\n/// Calls Pepper's `{e.symbol}`.\npublic func `{named.value()[i]}`({", ".join(parameters)}){result} {{\n{body.to_string()}}}\n"
        );
    }
    return Result<String, Diagnostic>.Ok(out.to_string());
}

# The Swift spelling of `ty`, as Swift imports its C type (`Int32`,
# `UnsafeMutablePointer<Int32>?`), or `String` or a handle's class.
_swift_type(ty: sema.TypeName, exports: sema.Exports, representations: HashMap<String, (String, long)>): String {
    if (sema.is_export_string(ty)) {
        return "String";
    }
    var handle = _handle_of(ty, exports);
    if (handle.is_value()) {
        return handle.value().c_type;
    }
    if (ty.is_extern_function_type()) {
        var parameters = Array<String>();
        for (var i in 1..ty.sub_types.count) {
            parameters.append(_swift_type(ty.sub_types[i], exports, representations));
        }
        return $"(@convention(c) ({", ".join(parameters)}) -> {_swift_type(ty.sub_types[0], exports, representations)})?";
    }
    if (ty.is_pointer()) {
        # A pointer to anything C has no plain name for is a `void*`.
        var target = sema.c_type(ty.sub_types[0], representations);
        if (!target.is_value() or target.value() == "void" or target.value().find("{") >= 0) {
            return "UnsafeMutableRawPointer?";
        }
        return $"UnsafeMutablePointer<{_swift_type(ty.sub_types[0], exports, representations)}>?";
    }
    var c = sema.c_type(ty, representations);
    var spelled = c.is_value() ? c.value() : "void";
    var names = [
        ("void", "Void"),
        ("bool", "Bool"),
        ("char", "CChar"),
        ("int8_t", "Int8"),
        ("uint8_t", "UInt8"),
        ("int16_t", "Int16"),
        ("uint16_t", "UInt16"),
        ("int32_t", "Int32"),
        ("uint32_t", "UInt32"),
        ("int64_t", "Int64"),
        ("uint64_t", "UInt64"),
        ("float", "Float"),
        ("double", "Double")
    ];
    for (var (from, to) in names) {
        if (spelled == from) {
            return to;
        }
    }
    return "OpaquePointer?";
}

## Returns the Java bindings of `exports`: a `.jar` holding the class
## `pepper.<name>.<Name>`, whose `static native` methods are the exports
## and whose initializer loads `lib<name>.so`, and a class for each handle
## (`AutoCloseable`, released by `close()`); and the C of their JNI
## functions, which includes `<name>.h`.
##
## @param name the library's name: its Java package and `System.loadLibrary` name
## @param exports what the program exports
## @param representations each enum's stored type, by name
## @returns the jar's bytes and the C source, or the error at the first
##   export Java cannot call: one that passes a C function pointer, or
##   whose name is a Java keyword or another's in camel case
export java_bindings(
    name: String, exports: sema.Exports, representations: HashMap<String, (String, long)>
): Result<(u8[], String), Diagnostic> {
    var named = _camel_names(exports, "Java");
    if (named.is_err()) {
        return _java_failed(named.error());
    }
    var package = $"pepper/{name}";
    var main = $"{package}/{_pascal(name)}";
    for (var i in 0..exports.functions.count) {
        var e = exports.functions[i];
        if (_is_java_keyword(named.value()[i])) {
            return _java_failed(
                sema.error_at(
                    $"cannot bind '{e.symbol}' to Java: '{named.value()[i]}' is a Java keyword", e.loc
                ).with_note("give it another C name with [Export(name = \"...\")]", Optional<Location>.Empty)
            );
        }
        var types = Array<(sema.TypeName, sema.Loc)>();
        for (var p in 0..e.parameters.count) {
            var (_, ty) = e.parameters[p];
            types.append((ty, p < e.parameter_locs.count ? e.parameter_locs[p] : e.loc));
        }
        types.append((e.result, e.loc));
        for (var (ty, at) in types) {
            var handle = _handle_of(ty, exports);
            if (handle.is_value() and $"{package}/{handle.value().c_type}" == main) {
                return _java_failed(
                    sema.error_at(
                        $"cannot bind '{e.symbol}' to Java: its struct '{handle.value().c_type}' has the name of the library's class, '{main.replace("/", ".")}'",
                        at
                    ).with_note("rename the struct, or the library with '-o'", Optional<Location>.Empty)
                );
            }
            if (!_java_type(ty, exports, package, representations).is_value()) {
                return _java_failed(_unbound(e, ty, at));
            }
        }
    }
    var glue = StringBuilder();
    glue.append($"/* {name}_jni.c: generated by the Pepper compiler. Do not edit.\n");
    glue.append($" * The JNI functions of the Java class {main.replace("/", ".")}, which call {name}.h's. */\n");
    glue.append(
        $"#include <jni.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"{name}.h\"\n"
    );
    glue.append(_JNI_HELPERS);
    var classes = Array<(String, u8[])>();
    var methods = Array<(String, String)>();
    for (var handle in exports.handles) {
        var class_name = $"{package}/{handle.c_type}";
        classes.append(
            (
                $"{class_name}.class",
                _class_file(class_name, ["java/lang/AutoCloseable"], true, [("close", "()V")], Optional<String>.Empty)
            )
        );
        glue.append(
            $"\nstatic jobject pepper_jni_wrap_{handle.c_type}(JNIEnv* env, {handle.c_type}* handle) {{\n    jclass type = (*env)->FindClass(env, \"{class_name}\");\n    jobject object = type ? (*env)->AllocObject(env, type) : NULL;\n    if (!object) {{\n        {handle.release}(handle);\n        return NULL;\n    }}\n    (*env)->SetLongField(env, object, (*env)->GetFieldID(env, type, \"handle\", \"J\"), (jlong)(intptr_t)handle);\n    return object;\n}}\n\nJNIEXPORT void JNICALL Java_{_jni_mangle(class_name)}_close(JNIEnv* env, jobject self) {{\n    jclass type = (*env)->GetObjectClass(env, self);\n    jfieldID field = (*env)->GetFieldID(env, type, \"handle\", \"J\");\n    {handle.c_type}* handle = ({handle.c_type}*)(intptr_t)(*env)->GetLongField(env, self, field);\n    (*env)->SetLongField(env, self, field, 0);\n    if (handle) {{\n        {handle.release}(handle);\n    }}\n}}\n"
        );
    }
    for (var i in 0..exports.functions.count) {
        var e = exports.functions[i];
        methods.append((named.value()[i], _java_descriptor(e, exports, package, representations)));
        glue.append(
            _jni_function(e, $"Java_{_jni_mangle(main)}_{_jni_mangle(named.value()[i])}", exports, representations)
        );
    }
    classes.append(($"{main}.class", _class_file(main, Array<String>(), false, methods, Optional<String>.Value(name))));
    return Result<(u8[], String), Diagnostic>.Ok((zip_stored(classes), glue.to_string()));
}

# `error` as `java_bindings`' result.
_java_failed(error: Diagnostic): Result<(u8[], String), Diagnostic> {
    return Result<(u8[], String), Diagnostic>.Err(error);
}

# The error for the export `e`, whose `ty` (written at `at`) Java cannot
# hold.
_unbound(e: sema.Export, ty: sema.TypeName, at: sema.Loc): Diagnostic {
    return sema.error_at(
        $"cannot bind '{e.symbol}' to Java: JNI cannot pass '{sema.display_name(ty.display())}'",
        at
    ).with_note(
        "Java passes numbers, 'bool', pointers (as 'long'), 'String' and struct handles; wrap the C function pointer in an export Java can call",
        Optional<Location>.Empty
    );
}

# The functions JNI functions share: a Java `String` as malloc'd UTF-8
# bytes and back (`String.getBytes` and `new String`, as JNI's own
# `GetStringUTFChars` is modified UTF-8), and a handle object's pointer.
const _JNI_HELPERS = "\nstatic void pepper_jni_throw(JNIEnv* env, const char* type, const char* message) {\n    jclass thrown = (*env)->FindClass(env, type);\n    if (thrown) {\n        (*env)->ThrowNew(env, thrown, message);\n    }\n}\n\nstatic char* pepper_jni_utf8(JNIEnv* env, jstring text, size_t* size) {\n    if (!text) {\n        pepper_jni_throw(env, \"java/lang/NullPointerException\", \"a String passed to Pepper is null\");\n        return NULL;\n    }\n    jclass type = (*env)->GetObjectClass(env, text);\n    jmethodID get_bytes = (*env)->GetMethodID(env, type, \"getBytes\", \"(Ljava/lang/String;)[B\");\n    jstring charset = (*env)->NewStringUTF(env, \"UTF-8\");\n    jbyteArray bytes = charset ? (jbyteArray)(*env)->CallObjectMethod(env, text, get_bytes, charset) : NULL;\n    if (!bytes) {\n        return NULL;\n    }\n    jsize count = (*env)->GetArrayLength(env, bytes);\n    char* out = malloc((size_t)count + 1);\n    if (!out) {\n        pepper_jni_throw(env, \"java/lang/OutOfMemoryError\", \"no memory for a String passed to Pepper\");\n        return NULL;\n    }\n    (*env)->GetByteArrayRegion(env, bytes, 0, count, (jbyte*)out);\n    (*env)->DeleteLocalRef(env, bytes);\n    (*env)->DeleteLocalRef(env, charset);\n    (*env)->DeleteLocalRef(env, type);\n    *size = (size_t)count;\n    return out;\n}\n\nstatic jstring pepper_jni_string(JNIEnv* env, const char* text) {\n    jsize count = (jsize)strlen(text);\n    jbyteArray bytes = (*env)->NewByteArray(env, count);\n    jclass type = (*env)->FindClass(env, \"java/lang/String\");\n    jstring charset = (*env)->NewStringUTF(env, \"UTF-8\");\n    if (!bytes || !type || !charset) {\n        return NULL;\n    }\n    (*env)->SetByteArrayRegion(env, bytes, 0, count, (const jbyte*)text);\n    jmethodID make = (*env)->GetMethodID(env, type, \"<init>\", \"([BLjava/lang/String;)V\");\n    return (jstring)(*env)->NewObject(env, type, make, bytes, charset);\n}\n\nstatic void* pepper_jni_handle(JNIEnv* env, jobject object) {\n    if (!object) {\n        pepper_jni_throw(env, \"java/lang/NullPointerException\", \"a Pepper object passed to Pepper is null\");\n        return NULL;\n    }\n    jclass type = (*env)->GetObjectClass(env, object);\n    void* handle = (void*)(intptr_t)(*env)->GetLongField(env, object, (*env)->GetFieldID(env, type, \"handle\", \"J\"));\n    (*env)->DeleteLocalRef(env, type);\n    if (!handle) {\n        pepper_jni_throw(env, \"java/lang/IllegalStateException\", \"a Pepper object passed to Pepper is closed\");\n    }\n    return handle;\n}\n";

# The JNI function `symbol` (without its `Java_`) that converts the
# arguments of the export `e`, calls it, and converts its result.
_jni_function(
    e: sema.Export, symbol: String, exports: sema.Exports, representations: HashMap<String, (String, long)>
): String {
    var parameters = ["JNIEnv* env", "jclass type"];
    var body = StringBuilder();
    var arguments = Array<String>();
    var frees = "";
    var fail = _is_void(e.result) ? "return;" : "return 0;";
    for (var p in 0..e.parameters.count) {
        var (_, ty) = e.parameters[p];
        parameters.append($"{_jni_type(ty, exports, representations)} p{p}");
        var handle = _handle_of(ty, exports);
        if (sema.is_export_string(ty)) {
            body.append(
                $"    size_t size{p};\n    char* text{p} = pepper_jni_utf8(env, p{p}, &size{p});\n    if (!text{p}) {{\n{frees}        {fail}\n    }}\n"
            );
            frees += $"        free(text{p});\n";
            arguments.append($"text{p}");
            arguments.append($"size{p}");
        } else if (handle.is_value()) {
            body.append(
                $"    {handle.value().c_type}* handle{p} = pepper_jni_handle(env, p{p});\n    if (!handle{p}) {{\n{frees}        {fail}\n    }}\n"
            );
            arguments.append($"handle{p}");
        } else if (ty.is_pointer()) {
            var c = sema.c_type(ty, representations);
            arguments.append($"({c.is_value() ? c.value() : "void*"})(intptr_t)p{p}");
        } else {
            var c = sema.c_type(ty, representations);
            arguments.append($"({c.is_value() ? c.value() : "int"})p{p}");
        }
    }
    var call = $"{e.symbol}({", ".join(arguments)})";
    var freed = frees.replace("        ", "    ");
    var handle = _handle_of(e.result, exports);
    if (_is_void(e.result)) {
        body.append($"    {call};\n{freed}");
    } else if (sema.is_export_string(e.result)) {
        body.append(
            $"    char* result = {call};\n{freed}    jstring out = pepper_jni_string(env, result);\n    {sema.STRING_FREE}(result);\n    return out;\n"
        );
    } else if (handle.is_value()) {
        body.append(
            $"    {handle.value().c_type}* result = {call};\n{freed}    return pepper_jni_wrap_{handle.value().c_type}(env, result);\n"
        );
    } else if (e.result.is_pointer()) {
        body.append($"    jlong out = (jlong)(intptr_t){call};\n{freed}    return out;\n");
    } else {
        var jni = _jni_type(e.result, exports, representations);
        body.append($"    {jni} out = ({jni}){call};\n{freed}    return out;\n");
    }
    return $"\nJNIEXPORT {_jni_type(e.result, exports, representations)} JNICALL {symbol}({", ".join(parameters)}) {{\n{body.to_string()}}}\n";
}

# The JNI C type of a Java parameter or result of type `ty`.
_jni_type(ty: sema.TypeName, exports: sema.Exports, representations: HashMap<String, (String, long)>): String {
    var descriptor = _java_type(ty, exports, "", representations);
    var d = descriptor.is_value() ? descriptor.value() : "V";
    var types = [
        ("V", "void"),
        ("Z", "jboolean"),
        ("B", "jbyte"),
        ("S", "jshort"),
        ("I", "jint"),
        ("J", "jlong"),
        ("F", "jfloat"),
        ("D", "jdouble"),
        ("Ljava/lang/String;", "jstring")
    ];
    for (var (from, to) in types) {
        if (d == from) {
            return to;
        }
    }
    return "jobject";
}

# The Java type descriptor of `ty` (`I`, `Ljava/lang/String;`, a handle's
# `L<package>/<class>;`), or none for one Java cannot hold: a C function
# pointer. Unsigned numbers keep their bits in the signed type of their
# size, and a pointer is a `long`.
_java_type(
    ty: sema.TypeName, exports: sema.Exports, package: String, representations: HashMap<String, (String, long)>
): String? {
    if (sema.is_export_string(ty)) {
        return Optional<String>.Value("Ljava/lang/String;");
    }
    var handle = _handle_of(ty, exports);
    if (handle.is_value()) {
        return Optional<String>.Value($"L{package}/{handle.value().c_type};");
    }
    if (ty.is_extern_function_type()) {
        return Optional<String>.Empty;
    }
    if (ty.is_pointer()) {
        return Optional<String>.Value("J");
    }
    var c = sema.c_type(ty, representations);
    var spelled = c.is_value() ? c.value() : "void";
    var descriptors = [
        ("void", "V"),
        ("bool", "Z"),
        ("char", "B"),
        ("int8_t", "B"),
        ("uint8_t", "B"),
        ("int16_t", "S"),
        ("uint16_t", "S"),
        ("int32_t", "I"),
        ("uint32_t", "I"),
        ("int64_t", "J"),
        ("uint64_t", "J"),
        ("float", "F"),
        ("double", "D")
    ];
    for (var (from, to) in descriptors) {
        if (spelled == from) {
            return Optional<String>.Value(to);
        }
    }
    return Optional<String>.Empty;
}

# The Java method descriptor of the export `e`: `(Ljava/lang/String;)I`.
_java_descriptor(
    e: sema.Export, exports: sema.Exports, package: String, representations: HashMap<String, (String, long)>
): String {
    var out = "(";
    for (var (_, ty) in e.parameters) {
        out += _java_type(ty, exports, package, representations).value();
    }
    return out + ")" + _java_type(e.result, exports, package, representations).value();
}

# The handle of the struct `ty`, if it is one.
_handle_of(ty: sema.TypeName, exports: sema.Exports): sema.Handle? {
    var key = ty.to_string();
    for (var handle in exports.handles) {
        if (handle.structure == key) {
            return Optional<sema.Handle>.Value(handle);
        }
    }
    return Optional<sema.Handle>.Empty;
}

_is_void(ty: sema.TypeName): bool {
    return ty.name == "void" and ty.sub_types.count == 0;
}

# Each export's name in `language`, in camel case, in the order of
# `exports.functions`; the error when two get the same one.
_camel_names(exports: sema.Exports, language: String): Result<String[], Diagnostic> {
    var out = Array<String>();
    var first = HashMap<String, sema.Export>();
    for (var e in exports.functions) {
        var named = camel_case(e.symbol);
        var other = first.try_get(named);
        if (other.is_value()) {
            var loc = other.value().loc;
            return Result<String[], Diagnostic>.Err(
                sema.error_at(
                    $"cannot bind '{e.symbol}' to {language} as '{named}': so is '{other.value().symbol}'",
                    e.loc
                ).with_note(
                    "the other is exported here", Optional<Location>.Value(Location(loc.file as ulong, loc.span))
                )
            );
        }
        first[named] = e;
        out.append(named);
    }
    return Result<String[], Diagnostic>.Ok(out);
}

## Returns the C identifier `name` in camel case, as Swift and Java name
## functions: each `_` dropped and the letter after it capitalized, but
## the first (`count_words` is `countWords`, `_next` is `next`); `name`
## itself when that leaves nothing.
##
## @param name the C identifier
## @returns its camel case
export camel_case(name: String): String {
    var out = "";
    for (var word in name.split("_")) {
        if (word.is_empty) {
            continue;
        }
        out += out.is_empty ? word : word.substr_bytes(0, 1).upper() + word.substr_bytes(1, word.size - 1);
    }
    return out.is_empty ? name : out;
}

# `name` in Pascal case, a Java class name: `my_lib` is `MyLib`.
_pascal(name: String): String {
    var camel = camel_case(name);
    return camel.substr_bytes(0, 1).upper() + camel.substr_bytes(1, camel.size - 1);
}

# A Java class or method name as JNI spells it in a C symbol: `/` is `_`
# and `_` is `_1`.
_jni_mangle(name: String): String {
    return name.replace("_", "_1").replace("/", "_");
}

# Whether `name` is one of Java's reserved words, which cannot name a
# method.
_is_java_keyword(name: String): bool {
    var words = " abstract assert boolean break byte case catch char class const continue default do double else enum extends false final finally float for goto if implements import instanceof int interface long native new null package private protected public return short static strictfp super switch synchronized this throw throws transient true try void volatile while ";
    return words.contains($" {name} ");
}

# A Java class file (version 52, Java 8) for the public final class `name`
# (`pepper/greeter/Greeter`), extending `Object` and implementing
# `interfaces`. `methods` (a name and a descriptor) are `public native`:
# instance methods with `instance`, which also gives the class the
# `long handle` field its JNI functions read; else `static`, with
# `library`'s `System.loadLibrary` in the class's initializer. The class
# has no constructor: only JNI's `AllocObject` makes one.
_class_file(name: String, interfaces: String[], instance: bool, methods: (String, String)[], library: String?): u8[] {
    var pool = _Pool();
    # `ldc` takes a one-byte index: the library's name comes first.
    ulong library_name = library.is_value() ? pool.string(library.value()) : 0;
    ulong load = library.is_value() ? pool.method("java/lang/System", "loadLibrary", "(Ljava/lang/String;)V") : 0;
    var this_class = pool.class_of(name);
    var super_class = pool.class_of("java/lang/Object");
    var body = Array<u8>();
    _put_be16(body, 0x0031);
    _put_be16(body, this_class);
    _put_be16(body, super_class);
    _put_be16(body, interfaces.count);
    for (var i in interfaces) {
        _put_be16(body, pool.class_of(i));
    }
    _put_be16(body, instance ? 1 : 0);
    if (instance) {
        # private long handle;
        _put_be16(body, 0x0002);
        _put_be16(body, pool.utf8("handle"));
        _put_be16(body, pool.utf8("J"));
        _put_be16(body, 0);
    }
    _put_be16(body, methods.count + (library.is_value() ? 1 : 0));
    for (var (method, descriptor) in methods) {
        _put_be16(body, instance ? 0x0101 : 0x0109);
        _put_be16(body, pool.utf8(method));
        _put_be16(body, pool.utf8(descriptor));
        _put_be16(body, 0);
    }
    if (library.is_value()) {
        # static { System.loadLibrary(library); }: ldc, invokestatic, return.
        _put_be16(body, 0x0008);
        _put_be16(body, pool.utf8("<clinit>"));
        _put_be16(body, pool.utf8("()V"));
        _put_be16(body, 1);
        _put_be16(body, pool.utf8("Code"));
        _put_u32(body, 18, true);
        _put_be16(body, 1);
        _put_be16(body, 0);
        _put_u32(body, 6, true);
        body.append(0x12);
        body.append(library_name as u8);
        body.append(0xb8);
        _put_be16(body, load);
        body.append(0xb1);
        _put_be16(body, 0);
        _put_be16(body, 0);
    }
    _put_be16(body, 0);
    var out = Array<u8>();
    _put_u32(out, 0xcafebabe, true);
    _put_be16(out, 0);
    _put_be16(out, 52);
    _put_be16(out, pool.count);
    out.append_all(pool.bytes);
    out.append_all(body);
    return out;
}

# A class file's constant pool: its entries' bytes, and the index the next
# one gets.
struct _Pool {
    var bytes: u8[] = Array<u8>();
    var count: ulong = 1;

    construct() {}

    # A `CONSTANT_Utf8` (ASCII here, which modified UTF-8 spells as is).
    utf8(text: String): ulong {
        bytes.append(1);
        _put_be16(bytes, text.size);
        bytes.append_all(text.bytes());
        return _next();
    }

    # A `CONSTANT_Class` named `name`.
    class_of(name: String): ulong {
        var named = utf8(name);
        bytes.append(7);
        _put_be16(bytes, named);
        return _next();
    }

    # A `CONSTANT_String` of `text`.
    string(text: String): ulong {
        var named = utf8(text);
        bytes.append(8);
        _put_be16(bytes, named);
        return _next();
    }

    # A `CONSTANT_Methodref` to `owner`'s `name` of type `descriptor`.
    method(owner: String, name: String, descriptor: String): ulong {
        var class_index = class_of(owner);
        var named = utf8(name);
        var typed = utf8(descriptor);
        bytes.append(12);
        _put_be16(bytes, named);
        _put_be16(bytes, typed);
        var both = _next();
        bytes.append(10);
        _put_be16(bytes, class_index);
        _put_be16(bytes, both);
        return _next();
    }

    _next(): ulong {
        count += 1;
        return count - 1;
    }
}

# Appends `value` as 2 big-endian bytes.
_put_be16(out: u8[], value: ulong) {
    out.append(((value >> 8) & 0xff) as u8);
    out.append((value & 0xff) as u8);
}
