## `pep-build --test`: the `main` a test build adds to the entry file.
##
## A test build defines the build option `TEST`, which keeps the `[Test]`
## functions every other build drops, loads the runtime's `testing` module
## into every file, and appends to the entry file's text a `main` that
## registers each of the file's `[Test]` functions with a `TestRunner`.
## The text goes after the file's last line, so it can name the file's
## private functions and every location before it stays where it was;
## `[TestMain]` makes it replace the file's own `main`.
##
## Given several files of one folder, the build makes one program of them
## all (`test_program`): each file gets an exported function that
## registers its own tests, and a generated entry file beside them imports
## every file and calls each one's from its `main`.

import compiler.ast;
import [Declaration, Expression, Literal] from compiler.ast;
import io;
import [File, Path] from io;
import compiler.link;
import compiler.parse;
import compiler.sema;

## The module a test build loads into every file, which declares
## `TestRunner` and `[TestMain]`.
export const TESTING_MODULE = "testing";

## The name of the file the generated entry of a test build of several
## files has, in their folder. Nothing is written there.
export const ENTRY_FILE = "_pep_test_main.pep";

## `source`, the text of the entry file `path`, with the test `main`
## appended. A file that does not parse is left as it is, for loading to
## report the error where it is.
##
## @param path the file
## @param source its text
## @returns the text to build
export add_test_main(path: Path, source: String): String {
    var registrations = _registrations(source);
    if (!registrations.is_value()) {
        return source;
    }
    var text = source.ends_with("\n") ? source : source + "\n";
    return text
        + "\n# Added by pep-build --test: runs this file's [Test] functions.\n[TestMain]\nmain(args: String[]): int {\n"
        + $"    var _pep_tests = TestRunner({_quoted(path.to_string())});\n"
        + registrations.value()
        + "    return _pep_tests.run(args);\n}\n";
}

## The program a test build of several files makes: the generated entry
## file, and each test file's text with the function that registers its
## tests added. The files must share one folder.
##
## @param paths the test files
## @returns the entry file and each file's text by `path_key`, or why they cannot make one program
export test_program(paths: Path[]): Result<(Path, HashMap<String, String>), String> {
    var folder = paths[0].parent().is_value() ? paths[0].parent().value() : Path("");
    var sources = HashMap<String, String>();
    var imports = "";
    var calls = "";
    ulong index = 0;
    for (var path in paths) {
        var parent = path.parent().is_value() ? path.parent().value() : Path("");
        if (parent.to_string() != folder.to_string()) {
            return Result<(Path, HashMap<String, String>), String>.err(
                $"--test: {path} is not in the folder of {paths[0]}; the files of one test program share a folder"
            );
        }
        var read = File.read_to_string(path);
        if (read.is_err()) {
            return Result<(Path, HashMap<String, String>), String>.err($"cannot read {path}: {read.error().message}");
        }
        var source = read.value();
        var stem = path.file_stem();
        if (!stem.is_value()) {
            index += 1;
            continue;
        }
        imports = imports + $"import {_quoted(stem.value())};\n";
        var registrations = _registrations(source);
        if (registrations.is_value()) {
            if (!source.ends_with("\n")) {
                source = source + "\n";
            }
            source = source
                + "\n# Added by pep-build --test: registers this file's [Test] functions.\n"
                + $"export _pep_register_tests_{index}(_pep_tests: TestRunner) "
                + "{\n"
                + $"    _pep_tests.from_file({_quoted(path.to_string())});\n"
                + registrations.value()
                + "}\n";
            calls = calls + $"    _pep_register_tests_{index}(_pep_tests);\n";
        }
        sources[link.path_key(path)] = source;
        index += 1;
    }
    var entry = folder.join(Path(ENTRY_FILE));
    var text = "# Generated by pep-build --test: runs the [Test] functions of every file\n# given.\n"
        + imports
        + "\n[TestMain]\nmain(args: String[]): int {\n"
        + $"    var _pep_tests = TestRunner({_quoted(folder.to_string())});\n"
        + calls
        + "    return _pep_tests.run(args);\n}\n";
    sources[link.path_key(entry)] = text;
    return Result<(Path, HashMap<String, String>), String>.ok((entry, sources));
}

## One `_pep_tests.add` (or `add_should_panic`) line per `[Test]` function
## of `source`, or Empty when it does not parse.
_registrations(source: String): String? {
    var module = parse.parse(source);
    if (module.is_err()) {
        return Optional<String>.Empty;
    }
    var out = "";
    for (var declaration in module.value().declarations) {
        if (declaration is Function(function)) {
            if (!ast.has_attribute(function.attributes, "Test")) {
                continue;
            }
            ulong line = 1;
            ulong i = 0;
            while (i < function.name_span.start) {
                if (source.byte_at(i) == '\n') {
                    line += 1;
                }
                i += 1;
            }
            var name = function.name;
            String? message;
            for (var attribute in function.attributes) {
                var attribute_name = sema.attribute_name(attribute);
                if (!attribute_name.is_value() or attribute_name.value() != "ShouldPanic") {
                    continue;
                }
                # `[ShouldPanic("text")]` or `[ShouldPanic(message = "text")]`;
                # sema reports any other argument.
                var text = "";
                for (var argument in sema.attribute_arguments(attribute)) {
                    if (argument.value is Literal(literal, _)) {
                        if (literal is String(written)) {
                            text = written;
                            break;
                        }
                    }
                }
                message = Optional<String>.Value(text);
            }
            if (message.is_value()) {
                out = out
                    + $"    _pep_tests.add_should_panic({_quoted(name)}, {name}, {line}, {_quoted(message.value())});\n";
            } else {
                out = out + $"    _pep_tests.add({_quoted(name)}, {name}, {line});\n";
            }
        }
    }
    return Optional<String>.Value(out);
}

## `text` as a Pepper string literal.
_quoted(text: String): String {
    var escaped = text
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t");
    return $"\"{escaped}\"";
}
