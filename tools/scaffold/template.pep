# The files `pep-new --lib` writes: those of the repository
# pep-lang/pepper-package-template, word for word, with its placeholder
# `mypkg` (the package's name) left in. Keep the two the same: the
# template's `.github/workflows/template.yml` runs `pepper new mypkg --lib
# --license Apache-2.0` with the build of main, on each change there and
# daily, and fails on any difference, so a change to one goes to the other
# too.

# Each file's path and text, in the order they are written.
export package_files(): OrderedMap<String, String> {
    var files = OrderedMap<String, String>();
    files[".github/workflows/ci.yml"] = _text(
        [
            "# Tests the package on each push to main and each pull request, and on a",
            "# vX.Y.Z tag also publishes a GitHub release for that tag and its",
            "# reference on the gh-pages branch, for GitHub Pages. Runs on",
            "# GitHub-hosted runners with the newest published Pepper toolchain,",
            "# installed with pep-lang/pepper's install scripts as a user installs it.",
            "#",
            "# Release: set `version` in pep.toml, merge, then",
            "#   git tag v1.0.0 && git push origin v1.0.0",
            "name: CI",
            "",
            "on:",
            "  push:",
            "    branches: [main]",
            "    tags: ['v*']",
            "  pull_request:",
            "  workflow_dispatch:",
            "",
            "permissions:",
            "  contents: read",
            "",
            "jobs:",
            "  test:",
            "    strategy:",
            "      fail-fast: false",
            "      matrix:",
            "        os: [ubuntu-24.04, windows-2025, macos-15]",
            "    runs-on: ${{ matrix.os }}",
            "    timeout-minutes: 30",
            "    steps:",
            "      - uses: actions/checkout@v7",
            "",
            "      - name: Install Pepper (Unix)",
            "        if: runner.os != 'Windows'",
            "        # The installer lists releases through the API; unauthenticated, macOS runners hit its rate limit (403).",
            "        env:",
            "          GITHUB_TOKEN: ${{ github.token }}",
            "        run: |",
            "          set -euo pipefail",
            "          curl -fsSL https://raw.githubusercontent.com/pep-lang/pepper/main/scripts/install.sh | sh",
            "          echo \"$HOME/.pepper/bin\" >> \"$GITHUB_PATH\"",
            "",
            "      - name: Install Pepper (Windows)",
            "        if: runner.os == 'Windows'",
            "        env:",
            "          GITHUB_TOKEN: ${{ github.token }}",
            "        shell: pwsh",
            "        run: |",
            "          irm https://raw.githubusercontent.com/pep-lang/pepper/main/scripts/install.ps1 | iex",
            "          \"$env:LOCALAPPDATA\\pepper\\bin\" | Out-File -Append -Encoding utf8 $env:GITHUB_PATH",
            "",
            "      - name: Test",
            "        shell: bash",
            "        # Fail when pep.lock is out of date with pep.toml, rather than build",
            "        # what a fresh resolve picks. The variable, not `--locked`: a",
            "        # toolchain without the option ignores it.",
            "        env:",
            "          PEPPER_LOCKED: '1'",
            "        run: bash tests/run.sh",
            "",
            "  # Tests with the toolchain pep.toml's `minimum_toolchain` names, so the",
            "  # minimum it states stays true; does nothing when it names none.",
            "  minimum-toolchain:",
            "    runs-on: ubuntu-24.04",
            "    timeout-minutes: 30",
            "    steps:",
            "      - uses: actions/checkout@v7",
            "",
            "      - name: Read the minimum",
            "        id: minimum",
            "        run: |",
            "          set -euo pipefail",
            "          minimum=\"$(sed -nE 's/^minimum_toolchain *= *\"([^\"]+)\".*/\\1/p' pep.toml | head -1)\"",
            "          echo \"version=$minimum\" >> \"$GITHUB_OUTPUT\"",
            "          [ -n \"$minimum\" ] || echo \"pep.toml names no minimum_toolchain: nothing to check\"",
            "",
            "      - name: Install Pepper at the minimum",
            "        if: steps.minimum.outputs.version != ''",
            "        env:",
            "          GITHUB_TOKEN: ${{ github.token }}",
            "          MINIMUM: ${{ steps.minimum.outputs.version }}",
            "        run: |",
            "          set -euo pipefail",
            "          curl -fsSL https://raw.githubusercontent.com/pep-lang/pepper/main/scripts/install.sh | sh -s -- --version \"$MINIMUM\"",
            "          echo \"$HOME/.pepper/bin\" >> \"$GITHUB_PATH\"",
            "",
            "      - name: Test",
            "        if: steps.minimum.outputs.version != ''",
            "        # Over any `toolchain` in pep.toml.",
            "        env:",
            "          PEPPER_TOOLCHAIN: ${{ steps.minimum.outputs.version }}",
            "          PEPPER_LOCKED: '1'",
            "        run: bash tests/run.sh",
            "",
            "  release:",
            "    needs: test",
            "    if: startsWith(github.ref, 'refs/tags/v')",
            "    runs-on: ubuntu-24.04",
            "    timeout-minutes: 5",
            "    permissions:",
            "      contents: write",
            "    steps:",
            "      - uses: actions/checkout@v7",
            "",
            "      # The tag must match pep.toml's version, so a release never names a",
            "      # version its manifest doesn't.",
            "      - name: Check the version",
            "        run: |",
            "          set -euo pipefail",
            "          want=\"$(sed -nE 's/^version *= *\"([^\"]+)\".*/\\1/p' pep.toml | head -1)\"",
            "          [ \"v$want\" = \"$GITHUB_REF_NAME\" ] || { echo \"::error::tag $GITHUB_REF_NAME but pep.toml says $want\"; exit 1; }",
            "",
            "      - name: Publish the release",
            "        env:",
            "          GH_TOKEN: ${{ github.token }}",
            "        run: gh release create \"$GITHUB_REF_NAME\" --title \"$GITHUB_REF_NAME\" --generate-notes --verify-tag",
            "",
            "  # Adds the release's reference (`pepper doc package`) to the gh-pages",
            "  # branch, a folder per version, which GitHub Pages serves once it is",
            "  # turned on for that branch (Settings, Pages).",
            "  docs:",
            "    needs: release",
            "    runs-on: ubuntu-24.04",
            "    timeout-minutes: 15",
            "    permissions:",
            "      contents: write",
            "    steps:",
            "      - uses: actions/checkout@v7",
            "",
            "      - name: Install Pepper and mdBook",
            "        env:",
            "          GITHUB_TOKEN: ${{ github.token }}",
            "          MDBOOK_VERSION: v0.4.52",
            "        run: |",
            "          set -euo pipefail",
            "          curl -fsSL https://raw.githubusercontent.com/pep-lang/pepper/main/scripts/install.sh | sh",
            "          echo \"$HOME/.pepper/bin\" >> \"$GITHUB_PATH\"",
            "          mkdir -p \"$RUNNER_TEMP/mdbook\"",
            "          curl -fsSL \"https://github.com/rust-lang/mdBook/releases/download/$MDBOOK_VERSION/mdbook-$MDBOOK_VERSION-x86_64-unknown-linux-gnu.tar.gz\" | tar -xz -C \"$RUNNER_TEMP/mdbook\"",
            "          echo \"$RUNNER_TEMP/mdbook\" >> \"$GITHUB_PATH\"",
            "",
            "      - name: Publish the reference",
            "        run: |",
            "          set -euo pipefail",
            "          # grep reads it all: with -q, pipefail could fail on pepper's broken pipe.",
            "          if ! pepper doc help | grep '^  package ' >/dev/null; then",
            "            echo \"this toolchain's pep-doc has no 'package': nothing to publish\"",
            "            exit 0",
            "          fi",
            "          site=\"$RUNNER_TEMP/site\"",
            "          if git ls-remote --exit-code --heads origin gh-pages; then",
            "            git fetch --depth 1 origin gh-pages",
            "            git worktree add --detach \"$site\" FETCH_HEAD",
            "          else",
            "            git worktree add --orphan -b gh-pages \"$site\"",
            "          fi",
            "          pepper doc package --site \"$site\"",
            "          git -C \"$site\" add -A",
            "          git -C \"$site\" -c user.name=github-actions -c user.email=github-actions@users.noreply.github.com commit -m \"Reference for $GITHUB_REF_NAME\"",
            "          git -C \"$site\" push origin HEAD:gh-pages",
        ]
    );
    files[".gitignore"] = _text(["/.pep/",]);
    files["README.md"] = _text(
        [
            "# pepper-mypkg",
            "",
            "One paragraph for [Pepper](https://github.com/pep-lang/pepper): what the",
            "package does and why someone would use it. Its reference:",
            "<https://OWNER.github.io/pepper-mypkg/>.",
            "",
            "One module, **`mypkg`**:",
            "",
            "- **`mypkg.greet(name)`** returns a greeting for `name`.",
            "",
            "```pepper",
            "import mypkg;",
            "",
            "main(): int {",
            "    print(mypkg.greet(\"Ada\"));   # Hello, Ada!",
            "    return 0;",
            "}",
            "```",
            "",
            "## Limits",
            "",
            "- What it does not do yet.",
            "",
            "## Using it",
            "",
            "This repository is a package: `pep.toml` marks its root, and its root",
            "`module.pep` is the `mypkg` module. Add it to a project under the name",
            "`mypkg`:",
            "",
            "```sh",
            "pepper package add OWNER/pepper-mypkg --name mypkg",
            "```",
            "",
            "which writes",
            "",
            "```toml",
            "[dependencies]",
            "mypkg = { github = \"OWNER/pepper-mypkg\" }",
            "```",
            "",
            "Without a project, put a folder named `mypkg` that holds (or links to)",
            "this repository on the import path: `pepper build -I packages main.pep`.",
            "",
            "## Tests",
            "",
            "```sh",
            "tests/run.sh path/to/pepper",
            "```",
            "",
            "runs the `[Test]` functions in `tests/` with `pepper test`. A package only",
            "the tests use goes in `[dev-dependencies]` (`pepper package add --dev",
            "OWNER/name`): projects that depend on this one do not fetch it.",
            "",
            "## Releasing",
            "",
            "CI (`.github/workflows/ci.yml`) runs the tests on Linux, macOS and",
            "Windows for every push to `main` and every pull request, and, when",
            "`pep.toml` sets `minimum_toolchain`, on Linux with that toolchain too, so",
            "the minimum it states stays true. It builds with `PEPPER_LOCKED=1`, the",
            "same as `pepper test --locked`: a `pep.lock` out of date with `pep.toml`",
            "fails the run, so commit `pep.lock` after changing a dependency. To",
            "release, set",
            "`version` in `pep.toml`, merge, then push the matching tag",
            "(`git tag v1.0.0 && git push origin v1.0.0`): CI tests the tag,",
            "publishes a GitHub release for it, and adds its reference (`pepper doc",
            "package`, from the `##` doc comments) to the `gh-pages` branch, which",
            "GitHub Pages serves once it is turned on for that branch (Settings,",
            "Pages). `pepper package add` and `pepper package update` find versions by",
            "their tags.",
            "",
            "## License",
            "",
            "Apache-2.0; see [LICENSE](LICENSE).",
        ]
    );
    files["greet.pep"] = _text(
        [
            "## Greetings: `greet`.",
            "",
            "## Returns a greeting for `name`.",
            "##",
            "## @param name who to greet",
            "## @returns `Hello, <name>!`",
            "## @example",
            "##     mypkg.greet(\"Ada\");   # \"Hello, Ada!\"",
            "export greet(name: String): String {",
            "    return $\"Hello, {name}!\";",
            "}",
        ]
    );
    files["module.pep"] = _text(
        [
            "## One sentence saying what the module does, then what a caller needs to",
            "## know before using it.",
            "##",
            "## Bring it in with `import mypkg`.",
            "##",
            "## - `greet`: what each part of the API is for",
            "##",
            "## @example",
            "##     import mypkg;",
            "##",
            "##     main(): int {",
            "##         print(mypkg.greet(\"Ada\"));   # Hello, Ada!",
            "##         return 0;",
            "##     }",
            "",
            "# This file only gathers the module's public API from its other files.",
            "",
            "import \"greet\";",
            "",
            "export greet;",
        ]
    );
    files["pep.toml"] = _text(
        [
            "[package]",
            "name = \"mypkg\"",
            "version = \"0.1.0\"",
            "description = \"One line saying what the package does\"",
            "license = \"Apache-2.0\"",
            "repository = \"https://github.com/OWNER/pepper-mypkg\"",
            "# The oldest Pepper toolchain that builds the package: CI also tests with",
            "# it, and `pepper package` skips a version whose minimum is newer than the",
            "# user's toolchain. Toolchains before 0.11 reject the key, so set it only",
            "# once the package needs 0.11 or later.",
            "# minimum_toolchain = \"0.11.0\"",
        ]
    );
    files["tests/greet_test.pep"] = _text(
        [
            "# The mypkg package's greetings.",
            "",
            "import mypkg;",
            "",
            "[Test]",
            "greets_by_name() {",
            "    expect_equal(mypkg.greet(\"Ada\"), \"Hello, Ada!\");",
            "}",
        ]
    );
    files["tests/run.sh"] = _text(
        [
            "#!/usr/bin/env bash",
            "# Runs the package's tests: the [Test] functions in tests/, with pepper test.",
            "#",
            "# Usage: tests/run.sh [path/to/pepper]   (default: pepper on PATH)",
            "set -euxo pipefail",
            "",
            "root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"",
            "pepper=\"${1:-pepper}\"",
            "build=\"$(mktemp -d)\"",
            "trap 'rm -rf \"$build\"' EXIT",
            "",
            "# The package is the module `mypkg`: a folder of that name on the import path.",
            "mkdir \"$build/packages\"",
            "ln -s \"$root\" \"$build/packages/mypkg\"",
            "\"$pepper\" test -I \"$build/packages\" \"$root/tests\"",
        ]
    );
    return files;
}

# The Apache License 2.0, as the template's LICENSE holds it.
export apache_license(): String {
    return _text(
        [
            "",
            "                                 Apache License",
            "                           Version 2.0, January 2004",
            "                        http://www.apache.org/licenses/",
            "",
            "   TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION",
            "",
            "   1. Definitions.",
            "",
            "      \"License\" shall mean the terms and conditions for use, reproduction,",
            "      and distribution as defined by Sections 1 through 9 of this document.",
            "",
            "      \"Licensor\" shall mean the copyright owner or entity authorized by",
            "      the copyright owner that is granting the License.",
            "",
            "      \"Legal Entity\" shall mean the union of the acting entity and all",
            "      other entities that control, are controlled by, or are under common",
            "      control with that entity. For the purposes of this definition,",
            "      \"control\" means (i) the power, direct or indirect, to cause the",
            "      direction or management of such entity, whether by contract or",
            "      otherwise, or (ii) ownership of fifty percent (50%) or more of the",
            "      outstanding shares, or (iii) beneficial ownership of such entity.",
            "",
            "      \"You\" (or \"Your\") shall mean an individual or Legal Entity",
            "      exercising permissions granted by this License.",
            "",
            "      \"Source\" form shall mean the preferred form for making modifications,",
            "      including but not limited to software source code, documentation",
            "      source, and configuration files.",
            "",
            "      \"Object\" form shall mean any form resulting from mechanical",
            "      transformation or translation of a Source form, including but",
            "      not limited to compiled object code, generated documentation,",
            "      and conversions to other media types.",
            "",
            "      \"Work\" shall mean the work of authorship, whether in Source or",
            "      Object form, made available under the License, as indicated by a",
            "      copyright notice that is included in or attached to the work",
            "      (an example is provided in the Appendix below).",
            "",
            "      \"Derivative Works\" shall mean any work, whether in Source or Object",
            "      form, that is based on (or derived from) the Work and for which the",
            "      editorial revisions, annotations, elaborations, or other modifications",
            "      represent, as a whole, an original work of authorship. For the purposes",
            "      of this License, Derivative Works shall not include works that remain",
            "      separable from, or merely link (or bind by name) to the interfaces of,",
            "      the Work and Derivative Works thereof.",
            "",
