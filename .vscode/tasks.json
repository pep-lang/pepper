{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": ["all"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "CMake template build task"
        },
        {
            "type": "cmake",
            "label": "CMake: test",
            "command": "test",
            "preset": "${command:cmake.activeTestPresetName}",
            "problemMatcher": [],
            "detail": "CMake template test task",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Pepper: Compile Current",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}/out/build/win-clang-x64-debug/pepper",
                "args": [
                    "-o",
                    "${workspaceFolder}/out/${fileBasenameNoExtension}.exe",
                    "${file}",
                    "-v",
                    "-emit-llvm",
                    "-Tall"
                ]
            },
            "command": "${workspaceFolder}/out/build/mac-llvm-clang-x64/pepper",
            "args": ["-o", "${workspaceFolder}/out/${fileBasenameNoExtension}", "${file}", "-v", "-emit-llvm"]
        },
        {
            "label": "Pepper: Compile test",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}/out/build/win-clang-x64-debug/pepper",
                "args": [
                    "-o",
                    "${workspaceFolder}/out/test.exe",
                    "${workspaceFolder}/tests/String.Append/test.pep",
                    "-v",
                    "-emit-llvm",
                    "-Tall"
                ]
            },
            "command": "${workspaceFolder}/out/build/mac-llvm-clang-x64/pepper",
            "args": ["-o", "${workspaceFolder}/out/test", "${file}", "-v", "-emit-llvm"]
        }
    ]
}
